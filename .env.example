# Copy to .env and fill in values. Never commit .env.
# Roles and current models: docs/LLM_PROVIDER.md

# Raw crawl data root (relative to repo root)
DATA_DIR=data

# ASR role: local ChunkFormer on the GPU (Hugging Face id; downloaded on first use)
ASR_MODEL=khanhld/chunkformer-ctc-large-vie
# Second ASR, only for segments the first one got wrong (asr_alt)
ASR_ALT_MODEL=vinai/PhoWhisper-medium

# Extractor role: UIT API (OpenAI-compatible, campus network only)
LLM_API_KEY=
EXTRACTOR_BASE_URL=https://llm.uit.edu.vn/gemma/v1
EXTRACTOR_MODEL=gemma-4-26b
EXTRACTOR_PARALLEL=36  # concurrent calls the endpoint takes: 36 on the UIT key (40 max), 48 on the LAN host

# Judge roles (place qc, dedup, status, audit): the UIT Gemma, 38 calls at once;
# no JUDGE_* endpoint. Audit engine: gemma = the Extractor Gemma, one strict round; empty = the Judge role's model
JUDGE_ENGINE=gemma
# Optional first reader of the audit (a model name on the Judge endpoint); empty = none
JUDGE_FIRST_MODEL=

# TLS: only needed on machines with an old CA store (see docs/LLM_PROVIDER.md)
# SSL_CERT_FILE=certs/uit-ca-bundle.pem
# CURL_CA_BUNDLE=certs/uit-ca-bundle.pem

# UIT API used by Judge and EXTRACTOR_ON_UIT.
UIT_API_KEY=
UIT_API_BASE_URL=https://llm.uit.edu.vn/gemma/v1
UIT_API_MODEL=gemma-4-26b

# Agent role: live Trip Understanding turns (python -m trip serve).
AGENT_API_KEY=
AGENT_BASE_URL=http://127.0.0.1:20128/v1
AGENT_MODEL=ag/gpt-oss-120b-medium

# TTS role: the assistant's voice, a VieNeu-TTS host (OpenAI-compatible POST /v1/audio/speech; docs/LLM_PROVIDER.md).
# Unset = no voice: the endpoint answers 503 and the web stays text-only. TTS_API_KEY may be any non-empty string if the host has no auth.
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=

# Contact put in the User-Agent of live-context requests. Nominatim's usage policy asks for one.
LIVE_CONTACT=

# Project Postgres: container tripguardian-pg on 127.0.0.1:5433 (./run.sh db creates it, the roles and the schema).
# Superuser password of the container; tg_app writes, tg_analytics only reads (python -m analytics serve).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://tg_app:CHANGE_ME@127.0.0.1:5433/tripguardian
DATABASE_URL_READONLY=postgresql://tg_analytics:CHANGE_ME@127.0.0.1:5433/tripguardian
# Tests marked pg run only with this set (a throwaway schema per test), e.g. the DATABASE_URL above.
# TEST_DATABASE_URL=

# Accounts (docs/ACCOUNTS.md). Public origin of the web app: cookies get Secure on https, mutations must come from it.
APP_BASE_URL=https://tripguardian.visioncare-host.uk
# Google OAuth client (login + Calendar share one callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tripguardian.visioncare-host.uk/api/auth/google/callback
# Fernet key for stored Google refresh tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
# Web push (docs/P5_COMPANION.md): VAPID key pair (base64url, P-256) and a contact URL or mailto:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
