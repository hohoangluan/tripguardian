# Copy to .env and fill in values. Never commit .env.
# Roles and current models: docs/LLM_PROVIDER.md

# Extractor role: UIT API (OpenAI-compatible, campus network only)
LLM_API_KEY=
EXTRACTOR_BASE_URL=https://llm.uit.edu.vn/gemma/v1
EXTRACTOR_MODEL=gemma-4-26b

# Judge role: OpenAI (must be a different model family than Extractor)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=

# TLS: only needed on machines with an old CA store (see docs/LLM_PROVIDER.md)
# SSL_CERT_FILE=certs/uit-ca-bundle.pem
# CURL_CA_BUNDLE=certs/uit-ca-bundle.pem
