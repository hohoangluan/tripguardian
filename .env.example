# Copy to .env and fill in values. Never commit .env.
# Roles and current models: docs/LLM_PROVIDER.md

# Raw crawl data root (relative to repo root)
DATA_DIR=data

# ASR role: local ChunkFormer on the GPU (Hugging Face id; downloaded on first use)
ASR_MODEL=khanhld/chunkformer-ctc-large-vie
# Second ASR, only for segments the first one got wrong (asr_alt)
ASR_ALT_MODEL=vinai/PhoWhisper-medium

# Extractor role: UIT API (OpenAI-compatible, campus network only)
LLM_API_KEY=
EXTRACTOR_BASE_URL=https://llm.uit.edu.vn/gemma/v1
EXTRACTOR_MODEL=gemma-4-26b

# Judge role: Gemma on UIT API (same model as Extractor)
JUDGE_API_KEY=
JUDGE_BASE_URL=https://llm.uit.edu.vn/gemma/v1
JUDGE_MODEL=gemma-4-26b

# TLS: only needed on machines with an old CA store (see docs/LLM_PROVIDER.md)
# SSL_CERT_FILE=certs/uit-ca-bundle.pem
# CURL_CA_BUNDLE=certs/uit-ca-bundle.pem

# Agent role: live Trip Understanding turns (python -m trip serve); Gemma on UIT API, same key as Extractor
AGENT_API_KEY=
AGENT_BASE_URL=https://llm.uit.edu.vn/gemma/v1
AGENT_MODEL=gemma-4-26b

# Contact put in the User-Agent of live-context requests. Nominatim's usage policy asks for one.
LIVE_CONTACT=
