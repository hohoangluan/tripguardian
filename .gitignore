.env
.env.*
!.env.example

# Generated CA bundle (system CAs + certs/*.pem), machine-specific
certs/uit-ca-bundle.pem

__pycache__/
.pytest_cache/
*.egg-info/

/data/
.browser/
.superpowers/

osrm-data/

# Run logs and pid files (./run.sh, background crawls)
logs/
*.pid

# Data bundle made by scripts/pack_data.py, shared outside git
tripguardian-data-*.zip

# Captured real pages (real reviewers, TikTok users): shared in the Drive data zip, not in the public repo
tests/fixtures/gmaps/
tests/fixtures/tiktok/

# model weights fetched by scripts (web/scripts/pick_covers.py)
/.cache/

# Local model experiments and training assets are not part of the application pipeline.
/system_one_model/
/training/

# Local agent tooling (Claude Code, opencode): per-machine, not part of the app
.claude/
.opencode/

# Competition material: the organizers' sample proposal (another project) and the scoring sheet photo
/TMA__proposal_vi.docx.md
/photo_*.jpg
# Raw research logs behind the submission report; the report and submission/evidence/ are what ships
/submission/research/
